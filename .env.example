# Web app
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# FastAPI
API_ENV=local
API_CORS_ORIGINS=http://localhost:3000
GUEST_SESSION_TTL_MINUTES=30
PENDING_ACTION_TTL_SECONDS=120
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-only-key
STAFF_DEMO_USERNAME=admin
STAFF_DEMO_PASSWORD=admin

# Azure Foundry GPT-Live (server-side only)
AZURE_OPENAI_ENDPOINT=https://replace-me.openai.azure.com
AZURE_OPENAI_API_KEY=replace-me
AZURE_OPENAI_DEPLOYMENT=replace-me
AZURE_OPENAI_API_VERSION=replace-me
AZURE_AGENT_ENABLED=false

# Uber Guest Rides sandbox (server-side only)
UBER_GUEST_RIDES_BASE_URL=https://sandbox-api.uber.com
UBER_SANDBOX_TOKEN=replace-me
UBER_SANDBOX_PARENT_PRODUCT_TYPE_ID=replace-me
